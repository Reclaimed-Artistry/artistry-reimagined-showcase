# Supabase public client configuration (publishable key is safe to expose in Vite builds;
# access is restricted by database row-level security). Do not put service-role keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# AdSense. The publisher id lives in source (src/lib/adsense.ts) because it is
# public; these are the *slot* ids, which are created in the AdSense dashboard
# under Ads > By ad unit. Ad code renders nothing until a slot id is present, and
# never runs inside the Android or iOS build.
#
# One shared id is enough to show ads on every page. The per-page overrides take
# precedence when a page has its own unit.
VITE_ADSENSE_SLOT_ID=
# VITE_ADSENSE_HOME_SLOT_ID=
# VITE_ADSENSE_READER_SLOT_ID=
# VITE_ADSENSE_PLANS_SLOT_ID=
# VITE_ADSENSE_REFLECTION_SLOT_ID=
# VITE_ADSENSE_STUDY_SLOT_ID=
# VITE_ADSENSE_VERSIONS_SLOT_ID=
